# Two-orbital Anderson model with Hubbard U and Hund's J, spin and charge symmetry (QS)

[template]
format=1
model=2orb-UJ
symtype=QS
channels=2
ops=n_d1 n_d1^2 n_d2 n_d2^2 S_d1S_d2 n_d1n_d2 A_d1 A_d2 self_d1 self_d2 sigma_d1 sigma_d2 SigmaHartree1 SigmaHartree2
params=U1 U2 eps1 eps2 U12 J12

[structure]
gf=imp:2
degeneracy=imp:2

[bath]
coefficient_channels=imp[0,0] imp[1,1]

[correlators]
G imp[0,0]=A_d1-A_d1
G imp[1,1]=A_d2-A_d2
F_l imp[0,0]=self_d1-A_d1
F_l imp[1,1]=self_d2-A_d2
F_r imp[0,0]=A_d1-self_d1
F_r imp[1,1]=A_d2-self_d2
I imp[0,0]=self_d1-self_d1
I imp[1,1]=self_d2-self_d2
chi_NN imp[0,0]=n_d1-n_d1
chi_NN imp[0,1]=n_d1-n_d2
chi_NN imp[1,0]=n_d2-n_d1
chi_NN imp[1,1]=n_d2-n_d2
chi_SS imp[0,0]=sigma_d1-sigma_d1
chi_SS imp[0,1]=sigma_d1-sigma_d2
chi_SS imp[1,0]=sigma_d2-sigma_d1
chi_SS imp[1,1]=sigma_d2-sigma_d2

[hartree]
imp[0,0]=SigmaHartree1
imp[1,1]=SigmaHartree2

[levels]
imp[0,0]=eps1
imp[1,1]=eps2
